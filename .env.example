# AIEX environment configuration
#
# Copy this file to `.env` and fill in your own values.  The real `.env` is
# gitignored so your key never gets committed.
#
# Required for `aiex run` (live LLM execution).
# Not required for `aiex compile` (offline budget report).

# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
