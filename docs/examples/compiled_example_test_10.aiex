PROGRAM DIVISION.
    PROGRAM-ID.         test-10-retrieval-budget.
    SOURCE-SPEC.        AILang v0.8.2.
    COMPILED-FROM.      "ailang-v0.8.2/tests/test_10_retrieval_budget.ailang".
    COMPILED-AT.        2026-04-16T15:00:00Z.
    TARGET-ENGINE.      claude-sonnet-4-6.
    AUTHOR.             ailang-compiler v0.1.
    TRACE-LEVEL.        FULL.
    DESCRIPTION.        "International trade compliance analysis
                         using graduated RETRIEVAL_BUDGET (NONE,
                         MINIMAL, STANDARD) across three DEDUCE
                         passes on identical premises, followed
                         by a COMPARE validation.
                         4 transactions total.".


*> ============================================================
*> ENGINE DIVISION
*> ============================================================
*> Compiled from: implicit engine defaults + AILang operation
*> types found during AST analysis.
*>
*> The compiler analyzed the source and found:
*>   - 3x DEDUCE operations → needs "deduce-logical" template
*>   - 1x COMPARE operation → needs "compare-rank" template
*>   - RETRIEVAL_BUDGET levels used: NONE, MINIMAL, STANDARD
*>   - DEPTH used: STANDARD only
*>   - No style modifiers (all default to INTELLIGENTLY)
*>   - No REALITY_CONTEXT
*>   - No REASONING_CONTEXT
*>   - No THEN chains
*>
*> The compiler selected models:
*>   - DEDUCE at STANDARD depth → GENERATIVE-STANDARD (Sonnet)
*>   - COMPARE at default depth → BERT-CLASS (cross-encoder)
*>     with FALLBACK-TO GENERATIVE-LIGHT (Haiku) because
*>     COMPARE output requires qualitative TEXT fields
*> ============================================================

ENGINE DIVISION.

    CONNECTION SECTION.
        API-ENDPOINT-GENERATIVE.
            URL             "https://api.anthropic.com/v1/messages".
            API-KEY-SOURCE  ENV "ANTHROPIC_API_KEY".
            TIMEOUT-MS      120000.
            RETRY-POLICY    3 ATTEMPTS WITH BACKOFF 1000 2000 4000.

        API-ENDPOINT-BERT.
            URL             "https://api.inference.endpoint/v1/embed".
            API-KEY-SOURCE  ENV "BERT_API_KEY".
            TIMEOUT-MS      5000.
            RETRY-POLICY    2 ATTEMPTS WITH BACKOFF 500 1000.

        API-ENDPOINT-VECTOR-DB.
            URL             "https://vectordb.internal/v1/search".
            API-KEY-SOURCE  ENV "VECTORDB_API_KEY".
            TIMEOUT-MS      3000.

    MODEL SECTION.
        DEFINE MODEL-POOL.
            BERT-CLASS.
                MODEL-ID        "colbert-v2".
                CAPABILITY      RETRIEVAL, CLASSIFICATION, RANKING.
                COST-PER-1K     0.00002.
                LATENCY-CLASS   FAST.
                MAX-TOKENS      512.

            GENERATIVE-LIGHT.
                MODEL-ID        "claude-haiku-4-5".
                CAPABILITY      ALL.
                COST-PER-1K-IN  0.001.
                COST-PER-1K-OUT 0.005.
                LATENCY-CLASS   MEDIUM.
                MAX-TOKENS      4096.

            GENERATIVE-STANDARD.
                MODEL-ID        "claude-sonnet-4-6".
                CAPABILITY      ALL.
                COST-PER-1K-IN  0.003.
                COST-PER-1K-OUT 0.015.
                LATENCY-CLASS   MEDIUM.
                MAX-TOKENS      8192.
        END-POOL.

    ROUTING SECTION.
        *> Only the reasoning types actually used in this program
        *> are included. The compiler prunes unused routes.

        ROUTING-TABLE reasoning-routes.
            WHEN DEDUCE:
                DISPATCH-TO             GENERATIVE-STANDARD.
                SYSTEM-PROMPT-TEMPLATE  "deduce-logical".
                TEMPERATURE             0.2.
                NEURON-BUDGET-FULL      1200.
                MAX-OUTPUT-TOKENS       1536.
            WHEN COMPARE:
                DISPATCH-TO             BERT-CLASS.
                ESCALATE-WHEN           OUTPUT-REQUIRES QUALITATIVE-TEXT.
                ESCALATE-TO             GENERATIVE-LIGHT.
                SYSTEM-PROMPT-TEMPLATE  "compare-rank".
                TEMPERATURE             0.3.
                NEURON-BUDGET-FULL      1050.
                MAX-OUTPUT-TOKENS       1024.
        END-TABLE.

    RETRIEVAL-BUDGET SECTION.
        BUDGET-TABLE retrieval-budgets.
            WHEN NONE:
                RETRIEVAL-NEURONS       0.
                VECTOR-SEARCH           DISABLED.
                PROMPT-MODIFIER         "CRITICAL INSTRUCTION: You MUST reason
                                         ONLY from the premises and data provided
                                         below. Do NOT use any external knowledge,
                                         regulatory details, case law, or facts not
                                         explicitly stated in the inputs. If the
                                         premises are insufficient to determine
                                         something, state 'insufficient_info'.".
                FALLBACK-TO             MINIMAL.
                FALLBACK-LOG            "RETRIEVAL_BUDGET: NONE could not be
                                         honored -- operation required knowledge
                                         recall not present in variables.".

            WHEN MINIMAL:
                RETRIEVAL-NEURONS       200.
                VECTOR-SEARCH           ENABLED TOP-K 3.
                VECTOR-INDEX            "terminology-definitions".
                PROMPT-MODIFIER         "You may resolve standard terminology and
                                         basic definitions relevant to the domain
                                         (e.g., legal terms of art, standard
                                         thresholds, procedural definitions). Do
                                         NOT inject detailed external knowledge
                                         such as specific case outcomes, current
                                         regulatory orders, historical precedents,
                                         or implementation details beyond basic
                                         terminology.".
                FALLBACK-TO             STANDARD.
                FALLBACK-LOG            "RETRIEVAL_BUDGET: MINIMAL expanded --
                                         operation required knowledge recall
                                         beyond terminology resolution.".

            WHEN STANDARD:
                RETRIEVAL-NEURONS       865.
                VECTOR-SEARCH           ENABLED TOP-K 10.
                VECTOR-INDEX            "regulatory-knowledge-full".
                PROMPT-MODIFIER         "".
                FALLBACK-TO             NONE.
        END-TABLE.

    DEPTH SECTION.
        *> Only STANDARD depth is used in this program.
        DEPTH-TABLE depth-levels.
            WHEN STANDARD:
                MAX-PASSES              1.
                TOKEN-MULTIPLIER        1.0.
                PROMPT-SUFFIX           "".
        END-TABLE.

    STYLE SECTION.
        *> No style modifiers used. Only default INTELLIGENTLY.
        STYLE-TABLE style-modifiers.
            WHEN INTELLIGENTLY:
                PROMPT-PREFIX           "".
                TEMPERATURE-ADJUSTMENT  0.
        END-TABLE.

    TEMPLATE SECTION.
        DEFINE TEMPLATE "deduce-logical".
            "You are executing a DEDUCE operation in an AILang v0.8.2
             program. Your task is logical deduction: derive conclusions
             from the stated premises using valid inference rules.

             REASONING TYPE: DEDUCE (logical inference from premises)
             Do not introduce premises not provided unless explicitly
             permitted by the retrieval budget below.

             {RETRIEVAL_MODIFIER}

             {DEPTH_SUFFIX}

             {BOUNDARY_INSTRUCTIONS}

             INPUTS:
             {FORMATTED_INPUTS}

             Respond in valid JSON matching the OUTPUT_FORMAT specified
             in the boundary instructions.".
        END-TEMPLATE.

        DEFINE TEMPLATE "compare-rank".
            "You are executing a COMPARE operation in an AILang v0.8.2
             program. Your task is comparative analysis: evaluate the
             provided items against the specified dimensions and produce
             a structured ranking with findings.

             REASONING TYPE: COMPARE (relative ordering and ranking)

             {BOUNDARY_INSTRUCTIONS}

             INPUTS:
             {FORMATTED_INPUTS}

             Respond in valid JSON matching the OUTPUT_FORMAT specified
             in the boundary instructions.".
        END-TEMPLATE.


*> ============================================================
*> STATE DIVISION
*> ============================================================
*> Compiled from: all SET statements + all result variables
*> (identified by the left-hand side of DEDUCE/COMPARE outputs)
*>
*> The compiler identified:
*>   - 5 premise variables (TEXT)
*>   - 1 case_facts variable (OBJECT)
*>   - 3 result variables from DEDUCE operations
*>   - 1 result variable from COMPARE operation
*>   - 1 system CURRENT-RESULT register
*>   - 1 system LAST-DISPATCH-META register
*> ============================================================

STATE DIVISION.

    VARIABLE SECTION.
        *> ---- Input Premises ----
        *> Compiled from: SET premise_1 TO "..."
        01 premise-1                TYPE TEXT
            VALUE "Under Section 232 of the Trade Expansion Act of
                   1962, the President may impose tariffs on imports
                   that threaten to impair national security, including
                   steel and aluminum products.".

        01 premise-2                TYPE TEXT
            VALUE "The United States-Mexico-Canada Agreement (USMCA)
                   provides preferential tariff treatment for goods
                   that meet the agreement's rules of origin, including
                   a regional value content threshold of 70% for steel
                   products to qualify for tariff-free treatment.".

        01 premise-3                TYPE TEXT
            VALUE "Anti-dumping duties are imposed when a foreign
                   manufacturer sells goods in the US at less than
                   fair value (LTFV), determined by comparing the
                   export price to the normal value in the home
                   market. The US Department of Commerce conducts
                   LTFV investigations.".

        01 premise-4                TYPE TEXT
            VALUE "Countervailing duties (CVDs) are imposed when a
                   foreign government provides subsidies to its
                   domestic producers that cause or threaten material
                   injury to a US domestic industry. The International
                   Trade Commission (ITC) determines material injury.".

        01 premise-5                TYPE TEXT
            VALUE "A product is classified under the Harmonized Tariff
                   Schedule (HTS) for duty determination. Hot-rolled
                   steel coils fall under HTS Chapter 72, subheading
                   7208. The applicable duty rate depends on the country
                   of origin, trade agreements in force, and any active
                   anti-dumping or countervailing duty orders.".

        *> ---- Case Data ----
        *> Compiled from: SET case_facts TO { ... }
        01 case-facts               TYPE OBJECT.
            05 exporter             TYPE TEXT
                VALUE "Northern Steel Corp., Hamilton, Ontario, Canada".
            05 importer             TYPE TEXT
                VALUE "Pacific Construction Supply, Seattle, WA, USA".
            05 product              TYPE TEXT
                VALUE "Hot-rolled carbon steel coils, 3mm, SAE 1020".
            05 hts-classification   TYPE TEXT
                VALUE "7208.27.00".
            05 shipment-value       TYPE TEXT
                VALUE "$2,400,000 USD (FOB Hamilton)".
            05 quantity             TYPE TEXT
                VALUE "1,200 metric tons".
            05 normal-value-canada  TYPE TEXT
                VALUE "$2,100 per metric ton in Canadian domestic market".
            05 export-price         TYPE TEXT
                VALUE "$2,000 per metric ton to US buyer".
            05 price-difference     TYPE TEXT
                VALUE "Export price is $100/ton below Canadian domestic
                       price (4.76% margin)".
            05 regional-value-content TYPE TEXT
                VALUE "82% -- manufactured from iron ore mined in
                       Labrador, processed in Hamilton".
            05 canadian-govt-subsidies TYPE TEXT
                VALUE "Northern Steel received CAD $15 million provincial
                       grant for facility modernization in 2024 under
                       Ontario's Manufacturing Innovation Fund".
            05 active-trade-orders  TYPE TEXT
                VALUE "The US has active AD/CVD orders on certain
                       hot-rolled steel from multiple countries; status
                       of Canadian orders requires verification".
            05 shipment-date        TYPE TEXT
                VALUE "2026-03-15".

    RESULT SECTION.
        *> ---- Operation Results ----
        *> One slot per DEDUCE/COMPARE operation.
        *> Populated by COMMIT after successful validation.
        01 tariff-result-none       TYPE OBJECT.
            88 POPULATED            WHEN NOT EMPTY.
        01 tariff-result-minimal    TYPE OBJECT.
            88 POPULATED            WHEN NOT EMPTY.
        01 tariff-result-standard   TYPE OBJECT.
            88 POPULATED            WHEN NOT EMPTY.
        01 compare-validation-result TYPE OBJECT.
            88 POPULATED            WHEN NOT EMPTY.

    SYSTEM SECTION.
        *> Runtime registers -- managed by the AIEX engine.
        01 CURRENT-RESULT           TYPE OBJECT.
            88 RESULT-READY         WHEN NOT EMPTY.
            88 RESULT-EMPTY         WHEN EMPTY.
        01 LAST-DISPATCH-META       TYPE OBJECT.
            05 tokens-in            TYPE NUMBER.
            05 tokens-out           TYPE NUMBER.
            05 model-used           TYPE TEXT.
            05 routing-applied      TYPE TEXT.
            05 retrieval-level      TYPE TEXT.
            05 depth-level          TYPE TEXT.
            05 latency-ms           TYPE NUMBER.
            05 cost-usd             TYPE NUMBER.
            05 fallbacks-triggered  TYPE NUMBER.
            05 retries-performed    TYPE NUMBER.
        01 EXECUTION-LOG            TYPE LIST OF OBJECT.


*> ============================================================
*> CONTRACT DIVISION
*> ============================================================
*> Compiled from: MUST_INCLUDE, CANNOT_INCLUDE, and OUTPUT_FORMAT
*> clauses on each DEDUCE and COMPARE operation.
*>
*> The compiler generates one CONTRACT per unique boundary set.
*> In this program:
*>   - Runs A and B share similar MUST_INCLUDE items
*>     but have different OUTPUT_FORMAT schemas
*>   - Run C has expanded MUST_INCLUDE
*>   - The COMPARE has its own contract
*>   - All three DEDUCE runs get retrieval-compliance checks
*>     calibrated to their RETRIEVAL_BUDGET level
*> ============================================================

CONTRACT DIVISION.

    *> --------------------------------------------------------
    *> CONTRACT: deduce-tariff-none
    *> For: DEDUCE tariff_applicability_none (Run A)
    *> RETRIEVAL_BUDGET: NONE -- strictest retrieval compliance
    *> --------------------------------------------------------
    DEFINE CONTRACT deduce-tariff-none.

        MUST-INCLUDE SECTION.
            *> Compiled from: MUST_INCLUDE: [each_premise_evaluated, ...]
            CHECK-PRESENT "section_232_applicability"
                IN RESPONSE.reasoning_chain
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: Section 232 applicability analysis".

            CHECK-PRESENT "usmca_qualification_analysis"
                IN RESPONSE.reasoning_chain
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: USMCA qualification analysis".

            CHECK-PRESENT "anti_dumping_margin_analysis"
                IN RESPONSE.reasoning_chain
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: anti-dumping margin analysis".

            CHECK-PRESENT "cvd_subsidy_analysis"
                IN RESPONSE.reasoning_chain
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: CVD subsidy analysis".

            CHECK-PRESENT "final_tariff_determination"
                IN RESPONSE.tariffs_apply
                DETECTION-METHOD FIELD-EXISTS
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: final tariff determination".

            CHECK-COUNT RESPONSE.reasoning_chain
                MINIMUM 5
                DETECTION-METHOD ARRAY-LENGTH
                ON-FAIL SEVERITY MAJOR
                MESSAGE "Not all 5 premises were individually evaluated".
        END-SECTION.

        CANNOT-INCLUDE SECTION.
            *> Compiled from: CANNOT_INCLUDE: [knowledge_not_in_premises,
            *>                                  external_regulatory_details]
            CHECK-ABSENT "external_regulatory_details"
                IN RESPONSE
                DETECTION-METHOD TERMINOLOGY-DIFF
                BASELINE premise-1, premise-2, premise-3,
                         premise-4, premise-5, case-facts
                SENSITIVITY HIGH
                ON-FAIL SEVERITY MAJOR
                MESSAGE "CANNOT_INCLUDE violated: response contains
                         external regulatory details not in premises".

            CHECK-ABSENT "knowledge_not_in_premises"
                IN RESPONSE
                DETECTION-METHOD KNOWLEDGE-DEPTH-SCAN
                THRESHOLD ZERO-EXTERNAL
                ON-FAIL SEVERITY MAJOR
                MESSAGE "CANNOT_INCLUDE violated: response contains
                         knowledge not derivable from premises".
        END-SECTION.

        OUTPUT-FORMAT SECTION.
            *> Compiled from: OUTPUT_FORMAT: { tariffs_apply: TEXT IN [...], ... }
            VALIDATE-SCHEMA RESPONSE AGAINST {
                tariffs_apply: TEXT
                    CONSTRAINED-TO ["yes_tariffs_apply",
                        "no_tariffs_exempt", "partially_applicable",
                        "insufficient_information"],
                section_232_status: TEXT,
                usmca_qualification: BOOLEAN,
                anti_dumping_risk: TEXT
                    CONSTRAINED-TO ["high", "moderate", "low",
                        "insufficient_info"],
                cvd_risk: TEXT
                    CONSTRAINED-TO ["high", "moderate", "low",
                        "insufficient_info"],
                reasoning_chain: LIST OF {
                    premise_number: NUMBER,
                    finding: TEXT,
                    applies: BOOLEAN
                },
                terminology_gaps: LIST OF TEXT,
                confidence_level: TEXT
                    CONSTRAINED-TO ["high", "moderate", "low"]
            }
            ON-FAIL SEVERITY CRITICAL
            MESSAGE "Output schema validation failed".
        END-SECTION.

        RETRIEVAL-COMPLIANCE SECTION.
            *> BUDGET: NONE -- strictest check
            SCAN RESPONSE FOR EXTERNAL-KNOWLEDGE
                DETECTION-METHOD TERMINOLOGY-DIFF
                BASELINE-SOURCES premise-1, premise-2, premise-3,
                                 premise-4, premise-5, case-facts
                TOLERANCE ZERO
                ON-FAIL SEVERITY MAJOR
                MESSAGE "RETRIEVAL_BUDGET: NONE violated --
                         response contains external knowledge"
                ACTION LOG-WARNING AND ANNOTATE.
        END-SECTION.

        SEVERITY-POLICY.
            CRITICAL-FAILURES:  ROLLBACK TRANSACTION.
            MAJOR-FAILURES:     RETRY WITH REINFORCED-PROMPT MAX 2.
            MINOR-FAILURES:     LOG-WARNING AND COMMIT.
        END-POLICY.
    END-CONTRACT.

    *> --------------------------------------------------------
    *> CONTRACT: deduce-tariff-minimal
    *> For: DEDUCE tariff_applicability_minimal (Run B)
    *> RETRIEVAL_BUDGET: MINIMAL -- terminology OK, details not
    *> --------------------------------------------------------
    DEFINE CONTRACT deduce-tariff-minimal.

        MUST-INCLUDE SECTION.
            *> Same as Run A, plus terminology_resolution
            CHECK-PRESENT "section_232_applicability"
                IN RESPONSE.reasoning_chain
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: Section 232 applicability analysis".

            CHECK-PRESENT "usmca_qualification_analysis"
                IN RESPONSE.reasoning_chain
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: USMCA qualification analysis".

            CHECK-PRESENT "anti_dumping_margin_analysis"
                IN RESPONSE.reasoning_chain
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: anti-dumping margin analysis".

            CHECK-PRESENT "cvd_subsidy_analysis"
                IN RESPONSE.reasoning_chain
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: CVD subsidy analysis".

            CHECK-PRESENT "terminology_resolution"
                IN RESPONSE.reasoning_chain
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY MAJOR
                MESSAGE "Missing: terminology resolution (expected
                         with RETRIEVAL_BUDGET: MINIMAL)".

            CHECK-PRESENT "final_tariff_determination"
                IN RESPONSE.tariffs_apply
                DETECTION-METHOD FIELD-EXISTS
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: final tariff determination".
        END-SECTION.

        CANNOT-INCLUDE SECTION.
            *> Compiled from: CANNOT_INCLUDE:
            *>   [speculation_beyond_premises_and_basic_terminology]
            CHECK-ABSENT "deep_external_knowledge"
                IN RESPONSE
                DETECTION-METHOD KNOWLEDGE-DEPTH-SCAN
                THRESHOLD TERMINOLOGY-ONLY
                ON-FAIL SEVERITY MAJOR
                MESSAGE "CANNOT_INCLUDE violated: response contains
                         knowledge deeper than terminology resolution".
        END-SECTION.

        OUTPUT-FORMAT SECTION.
            *> Same as Run A but with terminology_resolved in chain
            VALIDATE-SCHEMA RESPONSE AGAINST {
                tariffs_apply: TEXT
                    CONSTRAINED-TO ["yes_tariffs_apply",
                        "no_tariffs_exempt", "partially_applicable",
                        "insufficient_information"],
                section_232_status: TEXT,
                usmca_qualification: BOOLEAN,
                anti_dumping_risk: TEXT
                    CONSTRAINED-TO ["high", "moderate", "low",
                        "insufficient_info"],
                cvd_risk: TEXT
                    CONSTRAINED-TO ["high", "moderate", "low",
                        "insufficient_info"],
                reasoning_chain: LIST OF {
                    premise_number: NUMBER,
                    finding: TEXT,
                    applies: BOOLEAN,
                    terminology_resolved: LIST OF TEXT
                },
                terminology_gaps: LIST OF TEXT,
                confidence_level: TEXT
                    CONSTRAINED-TO ["high", "moderate", "low"]
            }
            ON-FAIL SEVERITY CRITICAL
            MESSAGE "Output schema validation failed".
        END-SECTION.

        RETRIEVAL-COMPLIANCE SECTION.
            *> BUDGET: MINIMAL -- terminology OK, deep knowledge not
            SCAN RESPONSE FOR DEEP-EXTERNAL-KNOWLEDGE
                DETECTION-METHOD KNOWLEDGE-DEPTH-SCAN
                THRESHOLD TERMINOLOGY-ONLY
                ON-FAIL SEVERITY MINOR
                MESSAGE "RETRIEVAL_BUDGET: MINIMAL may have exceeded
                         terminology resolution"
                ACTION LOG-WARNING.
        END-SECTION.

        SEVERITY-POLICY.
            CRITICAL-FAILURES:  ROLLBACK TRANSACTION.
            MAJOR-FAILURES:     RETRY WITH REINFORCED-PROMPT MAX 2.
            MINOR-FAILURES:     LOG-WARNING AND COMMIT.
        END-POLICY.
    END-CONTRACT.

    *> --------------------------------------------------------
    *> CONTRACT: deduce-tariff-standard
    *> For: DEDUCE tariff_applicability_standard (Run C)
    *> RETRIEVAL_BUDGET: STANDARD -- full knowledge, no restriction
    *> --------------------------------------------------------
    DEFINE CONTRACT deduce-tariff-standard.

        MUST-INCLUDE SECTION.
            *> Expanded: includes exemption history, implementation
            *> details, precedents, injury test
            CHECK-PRESENT "section_232_applicability_with_exemption_history"
                IN RESPONSE
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: Section 232 with exemption history".

            CHECK-PRESENT "usmca_qualification_with_implementation_details"
                IN RESPONSE
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: USMCA with implementation details".

            CHECK-PRESENT "anti_dumping_margin_analysis_with_precedents"
                IN RESPONSE
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: AD analysis with precedents".

            CHECK-PRESENT "cvd_subsidy_analysis_with_injury_test"
                IN RESPONSE
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: CVD analysis with injury test".

            CHECK-PRESENT "full_regulatory_context"
                IN RESPONSE
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY MAJOR
                MESSAGE "Missing: full regulatory context enrichment".

            CHECK-PRESENT "final_tariff_determination"
                IN RESPONSE.tariffs_apply
                DETECTION-METHOD FIELD-EXISTS
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: final tariff determination".
        END-SECTION.

        *> No CANNOT_INCLUDE for Run C -- full retrieval allowed.

        OUTPUT-FORMAT SECTION.
            VALIDATE-SCHEMA RESPONSE AGAINST {
                tariffs_apply: TEXT
                    CONSTRAINED-TO ["yes_tariffs_apply",
                        "no_tariffs_exempt", "partially_applicable",
                        "insufficient_information"],
                section_232_status: TEXT,
                section_232_exemption_details: TEXT,
                usmca_qualification: BOOLEAN,
                usmca_details: TEXT,
                anti_dumping_risk: TEXT
                    CONSTRAINED-TO ["high", "moderate", "low",
                        "insufficient_info"],
                anti_dumping_details: TEXT,
                cvd_risk: TEXT
                    CONSTRAINED-TO ["high", "moderate", "low",
                        "insufficient_info"],
                cvd_details: TEXT,
                reasoning_chain: LIST OF {
                    premise_number: NUMBER,
                    finding: TEXT,
                    applies: BOOLEAN,
                    external_context_used: LIST OF TEXT
                },
                confidence_level: TEXT
                    CONSTRAINED-TO ["high", "moderate", "low"]
            }
            ON-FAIL SEVERITY CRITICAL
            MESSAGE "Output schema validation failed".
        END-SECTION.

        RETRIEVAL-COMPLIANCE SECTION.
            *> BUDGET: STANDARD -- no restriction, just log what was used
            LOG RESPONSE EXTERNAL-KNOWLEDGE-ITEMS
                FOR-AUDIT "Regulatory context items used".
        END-SECTION.

        SEVERITY-POLICY.
            CRITICAL-FAILURES:  ROLLBACK TRANSACTION.
            MAJOR-FAILURES:     RETRY WITH REINFORCED-PROMPT MAX 2.
            MINOR-FAILURES:     LOG-WARNING AND COMMIT.
        END-POLICY.
    END-CONTRACT.

    *> --------------------------------------------------------
    *> CONTRACT: compare-budget-validation
    *> For: COMPARE validation across all three runs
    *> --------------------------------------------------------
    DEFINE CONTRACT compare-budget-validation.

        MUST-INCLUDE SECTION.
            CHECK-PRESENT "monotonic_enrichment_verification"
                IN RESPONSE
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: monotonic enrichment verification".

            CHECK-PRESENT "conclusion_alignment_check"
                IN RESPONSE
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY CRITICAL
                MESSAGE "Missing: conclusion alignment check".

            CHECK-PRESENT "terminology_gap_comparison"
                IN RESPONSE
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY MAJOR
                MESSAGE "Missing: terminology gap comparison".

            CHECK-PRESENT "retrieval_budget_compliance_check"
                IN RESPONSE
                DETECTION-METHOD SEMANTIC-SCAN
                ON-FAIL SEVERITY MAJOR
                MESSAGE "Missing: retrieval budget compliance check".
        END-SECTION.

        OUTPUT-FORMAT SECTION.
            VALIDATE-SCHEMA RESPONSE AGAINST {
                monotonic_enrichment: BOOLEAN,
                conclusions_consistent: BOOLEAN,
                terminology_precision_ranking: LIST OF TEXT,
                external_knowledge_ranking: LIST OF TEXT,
                confidence_progression: LIST OF TEXT,
                none_terminology_gaps: NUMBER,
                minimal_terminology_gaps: NUMBER,
                standard_terminology_gaps: NUMBER,
                budget_compliance: {
                    none_used_only_premises: BOOLEAN,
                    minimal_resolved_terminology_only: BOOLEAN,
                    standard_used_full_context: BOOLEAN
                },
                overall_validation: TEXT
                    CONSTRAINED-TO ["pass", "partial_pass", "fail"],
                findings: LIST OF TEXT
            }
            ON-FAIL SEVERITY CRITICAL
            MESSAGE "Validation output schema failed".
        END-SECTION.

        SEVERITY-POLICY.
            CRITICAL-FAILURES:  ROLLBACK TRANSACTION.
            MAJOR-FAILURES:     RETRY WITH REINFORCED-PROMPT MAX 2.
            MINOR-FAILURES:     LOG-WARNING AND COMMIT.
        END-POLICY.
    END-CONTRACT.


