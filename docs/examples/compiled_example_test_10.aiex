                            MESSAGE "Cannot validate: a DEDUCE
                                     transaction failed.".

    *> ========================================================
    *> TRANSACTION 4: COMPARE validation
    *> Source line: 181-213
    *> Compares all three DEDUCE results for monotonic enrichment
    *>
    *> Model selection: COMPARE normally routes to BERT-CLASS
    *> but this COMPARE's OUTPUT_FORMAT requires qualitative TEXT
    *> fields (findings, rankings) → escalated to GENERATIVE-LIGHT
    *> (Haiku). BERT can rank; it can't write analytical findings.
    *> ========================================================
    TRANSACTION compare-validation.
        DEPENDS-ON          deduce-tariff-none,
                            deduce-tariff-minimal,
                            deduce-tariff-standard.
        OPERATION           COMPARE.
        STYLE               INTELLIGENTLY.
        DEPTH               STANDARD.
        RETRIEVAL           NONE.
        CONTRACT            compare-budget-validation.

        INPUTS.
            ITEMS           tariff-result-none,
                            tariff-result-minimal,
                            tariff-result-standard.
            DIMENSIONS      conclusion_consistency,
                            terminology_precision,
                            external_knowledge_enrichment,
                            information_sufficiency,
                            reasoning_chain_richness,
                            confidence_level_progression.
        END-INPUTS.

        DISPATCH.
            *> Step 1: No retrieval needed -- comparing existing results
            SKIP RETRIEVAL-PHASE
                REASON "COMPARE of prior results, no external
                        knowledge needed".

            *> Step 2: Model escalation check
            *> COMPARE normally → BERT-CLASS
            *> But OUTPUT-REQUIRES QUALITATIVE-TEXT → escalate
            EVALUATE MODEL-SELECTION:
                ROUTING-TABLE SAYS     BERT-CLASS.
                ESCALATION-RULE        OUTPUT-REQUIRES QUALITATIVE-TEXT.
                ESCALATED-TO           GENERATIVE-LIGHT.
                LOG "Model escalated from BERT-CLASS to Haiku:
                     COMPARE output requires qualitative text
                     fields (findings, rankings).".
            END-EVALUATE.

            *> Step 3: Compose the prompt
            COMPOSE-PROMPT FROM:
                TEMPLATE    "compare-rank"
                REPLACING   {BOUNDARY_INSTRUCTIONS}
                    WITH    "Compare the three tariff analyses across
                             these dimensions:
                             1. conclusion_consistency
                             2. terminology_precision
                             3. external_knowledge_enrichment
                             4. information_sufficiency
                             5. reasoning_chain_richness
                             6. confidence_level_progression
                             You MUST include:
                             - Monotonic enrichment verification
                             - Conclusion alignment check
                             - Terminology gap comparison
                             - Retrieval budget compliance check
                             Respond in JSON matching: {OUTPUT_SCHEMA}"
                REPLACING   {FORMATTED_INPUTS}
                    WITH    FORMAT-AS-TEXT(INPUTS)
                REPLACING   {OUTPUT_SCHEMA}
                    WITH    CONTRACT.OUTPUT-FORMAT-SECTION.SCHEMA
            END-COMPOSE.

            *> Step 4: Send to Haiku (escalated from BERT)
            SEND TO GENERATIVE-LIGHT WITH:
                SYSTEM-PROMPT   COMPOSED-PROMPT.
                USER-MESSAGE    "Validate the three DEDUCE results for
                                 monotonic enrichment across retrieval
                                 budget levels.".
                TEMPERATURE     0.3.
                MAX-TOKENS      1024.
        END-DISPATCH.

        ON-RESPONSE.
            PARSE RESPONSE AS JSON
                ON-FAIL LOG-ERROR "Response is not valid JSON"
                        SEVERITY CRITICAL.

            VALIDATE AGAINST CONTRACT compare-budget-validation.

            IF ALL-BOUNDARIES-MET THEN
                COMMIT RESPONSE TO compare-validation-result
                LOG-SUCCESS "TX compare-validation COMMITTED"

                *> Log the overall test result
                IF RESPONSE.overall_validation = "pass" THEN
                    LOG-SUCCESS "=== TEST 10: PASS ==="
                ELSE
                    LOG-WARNING "=== TEST 10: {RESPONSE.overall_validation} ==="
                END-IF
            END-IF.

            IF SOME-BOUNDARIES-FAILED THEN
                PERFORM RETRY-WITH-REINFORCEMENT
                    USING CONTRACT.SEVERITY-POLICY
                    ADDING-TO-PROMPT VIOLATION-DETAILS
            END-IF.

            IF CRITICAL-FAILURE THEN
                ROLLBACK
                LOG-ERROR "TX compare-validation ROLLED BACK"
                HALT-PROGRAM WITH EXIT-CODE 1
            END-IF.
        END-ON-RESPONSE.
    END-TRANSACTION.

    *> ========================================================
    *> PROGRAM COMPLETE
    *> ========================================================
    PROGRAM-EXIT.
        LOG "=== Execution Complete ===".
        LOG "Transactions executed: 4".
        LOG "Transactions committed: {COUNT-COMMITTED}".
        LOG "Transactions rolled back: {COUNT-ROLLED-BACK}".
        LOG "Total retries: {TOTAL-RETRIES}".
        LOG "Total cost: ${TOTAL-COST}".
        LOG "Total latency: {TOTAL-LATENCY}ms".
        LOG "Models used: {DISTINCT-MODELS-USED}".
        DISPLAY EXECUTION-LOG.
        EXIT PROGRAM.


*> ============================================================
*> FALLBACK SECTION
*> ============================================================
*> Global fallback procedures referenced by ON-RESPONSE blocks.
*> ============================================================

FALLBACK SECTION.

    PROCEDURE RETRY-WITH-REINFORCEMENT.
        ACCEPT VIOLATION-DETAILS FROM CALLER.
        ACCEPT SEVERITY-POLICY FROM CALLER.
        ACCEPT MAX-RETRIES FROM SEVERITY-POLICY.

        COMPOSE REINFORCEMENT-PROMPT FROM:
            ORIGINAL-PROMPT
            APPEND "

            === RETRY INSTRUCTION ===
            Your previous response violated the following
            boundary constraints:
            {VIOLATION-DETAILS}

            You MUST fix these violations in your next response.
            All other instructions remain in effect.
            === END RETRY INSTRUCTION ===".
        END-COMPOSE.

        INCREMENT RETRY-COUNT.

        IF RETRY-COUNT > MAX-RETRIES THEN
            LOG-ERROR "Max retries ({MAX-RETRIES}) exceeded for
                       {CURRENT-TRANSACTION.NAME}"
            ESCALATE TO CRITICAL
        ELSE
            RE-DISPATCH CURRENT-TRANSACTION
                WITH REINFORCEMENT-PROMPT
            LOG-WARNING "Retry {RETRY-COUNT}/{MAX-RETRIES} for
                         {CURRENT-TRANSACTION.NAME}"
        END-IF.
    END-PROCEDURE.

    PROCEDURE RETRIEVAL-BUDGET-FALLBACK.
        *> Called when BERT retrieval returns insufficient results
        EVALUATE CURRENT-RETRIEVAL-LEVEL:
            WHEN NONE:
                LOG-WARNING BUDGET-TABLE.NONE.FALLBACK-LOG
                SET RETRIEVAL TO MINIMAL
                RE-DISPATCH CURRENT-TRANSACTION
            WHEN MINIMAL:
                LOG-WARNING BUDGET-TABLE.MINIMAL.FALLBACK-LOG
                SET RETRIEVAL TO STANDARD
                RE-DISPATCH CURRENT-TRANSACTION
            WHEN STANDARD:
                *> Already at maximum retrieval. No fallback.
                LOG-ERROR "RETRIEVAL: STANDARD insufficient --
                           no further fallback available"
                CONTINUE WITH CURRENT-RESULTS
        END-EVALUATE.
    END-PROCEDURE.
