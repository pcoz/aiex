                    ADDING-TO-PROMPT VIOLATION-DETAILS
            END-IF.

            IF CRITICAL-FAILURE THEN
                ROLLBACK
                LOG-ERROR "TX deduce-tariff-standard ROLLED BACK"
                HALT-PROGRAM WITH EXIT-CODE 1
            END-IF.
        END-ON-RESPONSE.
    END-TRANSACTION.

    *> ========================================================
    *> PARALLEL BARRIER
    *> TX-1, TX-2, TX-3 are in PARALLEL-GROUP group-1.
