    *> ========================================================
    *> TRANSACTION 2: DEDUCE tariff_applicability_minimal
    *> Source line: 97-126
    *> RETRIEVAL_BUDGET: MINIMAL → BERT terminology lookup first
    *> ========================================================
    TRANSACTION deduce-tariff-minimal.
        PARALLEL-GROUP      group-1.
        OPERATION           DEDUCE.
        STYLE               INTELLIGENTLY.
        DEPTH               STANDARD.
        RETRIEVAL           MINIMAL.
        CONTRACT            deduce-tariff-minimal.

        INPUTS.
            PREMISES        premise-1, premise-2, premise-3,
                            premise-4, premise-5.
            APPLY-TO        case-facts.
        END-INPUTS.

        DISPATCH.
            *> Step 1: RETRIEVAL_BUDGET: MINIMAL → BERT lookup
            *> Search the terminology index for trade law terms
            *> found in the premises and case facts.
            PERFORM RETRIEVAL-PHASE.
                EXTRACT-TERMS FROM INPUTS
                    USING BERT-CLASS MODEL "colbert-v2"
                    DOMAIN "international-trade-law"
                    INTO extracted-terms.
                    *> Expected terms: "LTFV", "material injury",
                    *> "HTS 7208", "countervailing duty",
                    *> "rules of origin", "Section 232",
                    *> "regional value content"

                SEARCH VECTOR-DB
                    INDEX "terminology-definitions"
                    QUERY extracted-terms
                    TOP-K 3
                    INTO terminology-results.
                    *> Returns ~3 concise definitions per term
                    *> E.g.: "LTFV (Less Than Fair Value): Under
                    *>  19 USC 1677(34), the price at which..."

                APPEND terminology-results TO INPUTS
                    AS "RESOLVED TERMINOLOGY (you may reference
                        these definitions but do not inject
                        knowledge beyond them)".
            END-RETRIEVAL-PHASE.

            *> Step 2: Compose the prompt (with terminology appended)
            USING ROUTING-TABLE reasoning-routes ENTRY DEDUCE.
            USING BUDGET-TABLE retrieval-budgets ENTRY MINIMAL.
            USING DEPTH-TABLE depth-levels ENTRY STANDARD.
            USING STYLE-TABLE style-modifiers ENTRY INTELLIGENTLY.

            COMPOSE-PROMPT FROM:
                TEMPLATE    "deduce-logical"
                REPLACING   {RETRIEVAL_MODIFIER}
                    WITH    BUDGET-TABLE.MINIMAL.PROMPT-MODIFIER
                REPLACING   {DEPTH_SUFFIX}
                    WITH    DEPTH-TABLE.STANDARD.PROMPT-SUFFIX
                REPLACING   {BOUNDARY_INSTRUCTIONS}
                    WITH    "You MUST include analysis of:
                             - Section 232 applicability
                             - USMCA qualification analysis
                             - Anti-dumping margin analysis
                             - CVD subsidy analysis
                             - Terminology resolution
                             - Final tariff determination
                             You MUST NOT include speculation beyond
                             premises and basic terminology.
                             Respond in JSON matching this schema:
                             {OUTPUT_SCHEMA}"
                REPLACING   {FORMATTED_INPUTS}
                    WITH    FORMAT-AS-TEXT(INPUTS-WITH-TERMINOLOGY)
                REPLACING   {OUTPUT_SCHEMA}
                    WITH    CONTRACT.OUTPUT-FORMAT-SECTION.SCHEMA
            END-COMPOSE.

            *> Step 3: Send to Sonnet
            SEND TO GENERATIVE-STANDARD WITH:
                SYSTEM-PROMPT   COMPOSED-PROMPT.
                USER-MESSAGE    "Analyze whether tariffs apply. You may
                                 use the resolved terminology provided
                                 but do not inject further knowledge.".
                TEMPERATURE     0.2.
                MAX-TOKENS      1536.
        END-DISPATCH.

        ON-RESPONSE.
            PARSE RESPONSE AS JSON
                ON-FAIL LOG-ERROR "Response is not valid JSON"
                        SEVERITY CRITICAL.

            VALIDATE AGAINST CONTRACT deduce-tariff-minimal.

            IF ALL-BOUNDARIES-MET THEN
                COMMIT RESPONSE TO tariff-result-minimal
                LOG-SUCCESS "TX deduce-tariff-minimal COMMITTED"
                UPDATE LAST-DISPATCH-META WITH:
                    model-used          "colbert-v2 + claude-sonnet-4-6"
                    routing-applied     "BERT-RETRIEVE + DEDUCE"
                    retrieval-level     "MINIMAL"
                    depth-level         "STANDARD"
                    fallbacks-triggered 0
                    retries-performed   0
            END-IF.

            IF SOME-BOUNDARIES-FAILED THEN
                PERFORM RETRY-WITH-REINFORCEMENT
                    USING CONTRACT.SEVERITY-POLICY
                    ADDING-TO-PROMPT VIOLATION-DETAILS
            END-IF.

            IF CRITICAL-FAILURE THEN
                ROLLBACK
                LOG-ERROR "TX deduce-tariff-minimal ROLLED BACK"
                HALT-PROGRAM WITH EXIT-CODE 1
            END-IF.
        END-ON-RESPONSE.
    END-TRANSACTION.

    *> ========================================================
    *> TRANSACTION 3: DEDUCE tariff_applicability_standard
    *> Source line: 137-168
    *> RETRIEVAL_BUDGET: STANDARD → full BERT knowledge retrieval
    *> ========================================================
    TRANSACTION deduce-tariff-standard.
        PARALLEL-GROUP      group-1.
        OPERATION           DEDUCE.
        STYLE               INTELLIGENTLY.
        DEPTH               STANDARD.
        RETRIEVAL           STANDARD.
        CONTRACT            deduce-tariff-standard.

